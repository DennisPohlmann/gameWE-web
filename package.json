{
  "name": "gamewe-web",
  "version": "1.15.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "node scripts/vendor.mjs && node scripts/licenses.mjs && next dev",
    "build": "node scripts/vendor.mjs && node scripts/licenses.mjs && tsc -p tsconfig.radar.json && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"out/tests/tests/*.test.js\"",
    "create-admin": "node scripts/create-admin.mjs",
    "templates": "node scripts/modern-templates.mjs",
    "shots": "node scripts/skin-shots.mjs",
    "flags": "node scripts/flags-sprite.mjs",
    "game-icons": "node scripts/game-icons.mjs",
    "radar": "tsc -p tsconfig.radar.json && node scripts/overviews/build/radar.js",
    "radar:all": "tsc -p tsconfig.radar.json && node scripts/overviews/build/run_all.js"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "leaflet": "^1.9.4",
    "mysql2": "^3.24.6",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@scalar/api-reference": "1.78.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
