# gameWE web - copy to .env.local (development) or /etc/gamewe/web/web.env (systemd).

# Database: the same database the gameWE collector writes.
# DB_TYPE: mariadb (also for MySQL) or postgres.
# A user with SELECT rights is enough for the public pages.
DB_TYPE=mariadb
DB_HOST=127.0.0.1
# Default: 3306 for mariadb, 5432 for postgres.
DB_PORT=3306
DB_USER=gamewe_web
DB_PASSWORD=change-me
DB_NAME=gamewe
# Prefix of the table names, the same as database.table_prefix of the
# collector (default hlstats: hlstats_Players; gw: gw_Players).
#DB_TABLE_PREFIX=hlstats

# Optional second user for the admin area, with INSERT/UPDATE/DELETE rights.
# Without it the admin area writes with DB_USER. The chat is read with this
# user too, since the public user needs no access to it.
#DB_ADMIN_USER=gamewe_web_admin
#DB_ADMIN_PASSWORD=change-me

# Signs the admin session cookie. At least 32 characters: openssl rand -hex 32
# Without it the admin area stays locked.
ADMIN_SECRET=

# TLS to the database: off (default; "disable" works too), required (verify
# the certificate), or skip-verify (encrypt without checking the certificate).
# Once TLS is on, the connection never falls back to plaintext.
DB_TLS=off
# CA file for DB_TLS=required with a private CA.
#DB_TLS_CA=/etc/gamewe/web/ca.pem

# Sub path behind a reverse proxy, e.g. /new for https://example.org/new.
# Empty: the site runs at the root.
#BASE_PATH=

# Time zone for all times shown on the site and for its days: when "today"
# starts, the award days, the daily charts (IANA name). Without it the
# server's zone is used, in the Docker image UTC. Set the collector to the
# same zone, it writes the daily history and the award days in its own.
TZ=Europe/Berlin

# Your own design templates and map overviews are not set here: they are read
# from the fixed folders /var/lib/gamewe/web/templates and
# /var/lib/gamewe/web/overviews (in Docker mount them there), see
# docs/INSTALLATION.md. TEMPLATES_DIR and OVERVIEWS_DIR (up to v0.35) are
# ignored.

# The SourceBans address (Settings → Bans) must be a public address; set this
# to 1 when SourceBans runs on the same machine or LAN.
#SOURCEBANS_ALLOW_PRIVATE=0

# Access log on stdout: on (default), off, or all (also /healthz).
#ACCESS_LOG=on

# Legacy fallbacks: site title, default language, activity days, rows per
# page, Steam profiles and the Steam Web API key (and the /-/metrics token)
# are set in Admin > Settings and stored in the database. These variables
# are only read while the setting is not stored yet; saving the settings
# page moves their value into the database. New installations leave them out.
#SITE_NAME=gameWE
#DEFAULT_LANG=de
#ACTIVITY_DAYS=28
#PAGE_SIZE=50
#STEAM_PROFILES=on
#STEAM_API_KEY=
#GAMEWE_METRICS_TOKEN=
